# Automatic dark/light switching
theme = dark:Rose Pine Moon,light:Rose Pine Moon 

font-size = 16

# Or set individual themes
# theme = Rose Pine
# theme = Rose Pine Moon
# theme = Rose Pine Dawn

# Close the current split pane (not the whole tab)
keybind = ctrl+shift+d=close_surface

# Background transparency (0.0 to 1.0)
background-opacity = 0.95

# Initial window size in columns and rows
window-width = 200
window-height = 48

# Per-OS settings. install.sh points config.os at config.macos or config.linux.
# Loaded last, so anything here overrides the settings above. The leading ?
# keeps Ghostty quiet if the link hasn't been created yet.
config-file = ?config.os

